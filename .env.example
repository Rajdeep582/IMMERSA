# ---- Doctor Murphy (server side only — never prefixed with VITE_) ----
# Free key: https://aistudio.google.com/apikey  (do NOT enable billing on that Google project → it can never cost money)
GEMINI_API_KEY=
# Optional overrides
# MURPHY_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# MURPHY_FAST_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.6-flash
# MURPHY_RATE_PER_MINUTE=10
# NCBI_API_KEY=            # optional, raises PubMed limit from 3 to 10 requests/s
# NCBI_EMAIL=
# Optional backup provider (any OpenAI-compatible API, e.g. Groq free tier)
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODELS=openai/gpt-oss-120b

# ---- App side (public, baked into the build) ----
# Android app only: full URL of the deployed function, e.g. https://immersa.vercel.app/api/murphy
# VITE_MURPHY_API=
